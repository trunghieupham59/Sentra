<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath.io Artifact Configuration for Sentra Windows Installer
  =========================================================================
  Paste this XML vào SignPath:
    Project → Artifact Configurations → [tên config] → Edit → tab "XML editor"

  Docs: https://about.signpath.io/documentation/artifact-configuration
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <!--
    ZIP chứa: installer NSIS (*.exe) và các PE files (*.dll, *.exe) từ win-unpacked
    Dùng wildcard *.exe và *.dll để match bất kỳ tên file nào
  -->
  <zip-file>
    <pe-file-set>
      <include path="*.exe" />
      <include path="*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
