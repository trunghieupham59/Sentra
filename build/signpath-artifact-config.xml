<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath.io Artifact Configuration for T.R.E Assistant Windows Installer
  =========================================================================
  Upload this file in your SignPath project under:
    Project → Artifact Configurations → Create → "Edit XML" tab
  Set the slug to: "windows-installer"

  This config signs the NSIS installer + all embedded PE files (EXE, DLL)
  inside a zip package.

  Docs: https://about.signpath.io/documentation/artifact-configuration
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <!--
    Workflow gửi một file ZIP chứa:
      - installer NSIS (.exe)
      - các file PE bên trong app (*.exe, *.dll)
    SignPath sẽ ký tất cả các PE file tìm thấy trong ZIP.
  -->
  <zip-file>
    <pe-image path-regex="[^/]*\.exe">
      <authenticode-sign/>
    </pe-image>
    <pe-image path-regex="[^/]*\.dll">
      <authenticode-sign/>
    </pe-image>
  </zip-file>
</artifact-configuration>
