{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/*.css",
      "!**/*.md",
      "!build",
      "!dist",
      "!dist-electron",
      "!node_modules",
      "!public/vad",
      "!release"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
